# Database Connection URL
# For Local Development (Direct Python):
# DATABASE_URL="postgresql://username:password@localhost:5432/database_name"
#
# For Docker Compose:
# DATABASE_URL="postgresql://postgres:postgrespassword@db:5432/inventory"
#
# For Production / Supabase:
# DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<db>"
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/inventory"

# API Configuration
PROJECT_NAME="Analog Inventory System"
VERSION="1.0.0"
API_V1_STR="/api/v1"
